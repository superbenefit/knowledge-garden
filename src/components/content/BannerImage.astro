---
interface Props {
  banner?: string;
  title?: string;
}

const { banner, title = "Banner image" } = Astro.props;

let src: string | undefined;

if (banner) {
  let imagePath: string | null = null;

  // Handle Obsidian wiki-link format: "![[attachments/image.webp]]"
  const wikiLinkMatch = banner.match(/!?\[\[(.+?)\]\]/);
  if (wikiLinkMatch && wikiLinkMatch[1]) {
    imagePath = wikiLinkMatch[1];
  } else {
    imagePath = banner;
  }

  if (imagePath) {
    // External URLs stay as-is; internal paths get leading slashes stripped and prefixed with /
    const isExternal = imagePath.startsWith("http");
    src = isExternal ? imagePath : "/" + imagePath.replace(/^\/+/, "");
  }
}
---

{src && (
  <div class="banner-image">
    <img src={src} alt={title} loading="eager" />
  </div>
)}

<style>
  .banner-image {
    width: 100%;
    margin: 1rem 0 0.5rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .banner-image img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 800px) {
    .banner-image {
      margin: 0.5rem 0 0.25rem 0;
      border-radius: 0.25rem;
    }

    .banner-image img {
      max-height: 250px;
    }
  }
</style>
