---
interface Props {
  license?: string;
  author?: string;
  authorUrl?: string;
  title: string;
  date?: string;
}

const { license, author, authorUrl, title, date: _date } = Astro.props;

// Parse license string like "CC-BY-SA-4.0"
const parts = license ? license.toUpperCase().split("-") : [];
const isCC = parts[0] === "CC";
const show = !!(license && isCC);

// Extract CC components (BY, SA, NC, ND, ZERO)
const components = show ? parts.slice(1).filter((p) => !p.match(/^\d/)) : [];
const version = show ? (parts.find((p) => p.match(/^\d/)) || "4.0") : "4.0";

// Handle CC0 / CC-ZERO
const isZero = show && (components.includes("ZERO") || components.includes("0") || license!.toUpperCase().includes("CC0"));

// Build license URL
let licenseUrl = "";
if (show) {
  if (isZero) {
    licenseUrl = `https://creativecommons.org/publicdomain/zero/${version}/`;
  } else {
    const slug = components.join("-").toLowerCase();
    licenseUrl = `https://creativecommons.org/licenses/${slug}/${version}/`;
  }
}

// Human-readable name
let licenseName = "";
if (show) {
  if (isZero) {
    licenseName = `CC0 ${version} Universal`;
  } else {
    licenseName = `CC ${components.join("-")} ${version}`;
  }
}

// Shield badge components for icons
const badgeComponents = isZero ? ["zero"] : components.map((c) => c.toLowerCase());
const authorDisplay = author || "the author";
---

{show && <div class="license-info">
  <div class="license-icons">
    <a href={licenseUrl} target="_blank" rel="noopener noreferrer license" aria-label={licenseName}>
      <svg class="cc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8Zm-1.53-5.72c.37.55.87.83 1.53.83.48 0 .87-.13 1.17-.39.3-.26.5-.62.6-1.06l1.73.56c-.23.76-.68 1.38-1.33 1.84-.65.46-1.38.69-2.17.69-.57 0-1.1-.12-1.58-.35a3.4 3.4 0 0 1-1.2-.97 4.38 4.38 0 0 1-.77-1.44 5.7 5.7 0 0 1-.27-1.77c0-.62.09-1.2.28-1.76.19-.55.46-1.04.81-1.44.36-.41.79-.73 1.3-.96.5-.24 1.07-.36 1.7-.36.73 0 1.36.21 1.91.63.55.42.93 1.01 1.14 1.76l-1.77.56c-.08-.36-.25-.67-.51-.92-.26-.25-.58-.37-.96-.37-.61 0-1.08.28-1.42.85-.34.57-.51 1.26-.51 2.08 0 .82.17 1.5.51 2.03Z"/>
      </svg>
      {badgeComponents.includes("by") && (
        <svg class="cc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8Zm0-14a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm2 6H10c-.55 0-1 .45-1 1v5h2v-4h2v4h2v-5c0-.55-.45-1-1-1Z"/>
        </svg>
      )}
      {badgeComponents.includes("sa") && (
        <svg class="cc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8Zm1.88-6.35c-.31.62-.78 1.07-1.38 1.35l.95 1.65-1.24.7-.9-1.55c-.15.02-.3.03-.43.03-1.31 0-2.36-.58-3.15-1.73l1.38-.95c.52.78 1.1 1.17 1.73 1.17.35 0 .65-.1.9-.29.25-.2.37-.45.37-.77 0-.52-.4-.95-1.2-1.28-.28-.12-.5-.22-.66-.3a4.02 4.02 0 0 1-1.16-.87c-.31-.37-.47-.82-.47-1.36 0-.72.26-1.3.79-1.73.52-.44 1.15-.65 1.87-.65 1.08 0 1.95.49 2.63 1.47l-1.33 1c-.42-.66-.9-1-1.42-1-.26 0-.48.08-.65.24a.76.76 0 0 0-.26.58c0 .4.38.76 1.15 1.08.62.26 1.08.49 1.38.68.65.42 1.08.88 1.28 1.38.13.34.2.7.2 1.08 0 .34-.06.64-.17.92Z"/>
        </svg>
      )}
      {badgeComponents.includes("nc") && (
        <svg class="cc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8Zm.5-11.5V7h-1v1.5H10v1h2.5v1H10v1h1.29L9.5 15h1.62l1.38-2.76L13.88 15h1.62l-1.79-3.5H15v-1h-2.5v-1H15v-1h-2.5Z"/>
        </svg>
      )}
      {badgeComponents.includes("nd") && (
        <svg class="cc-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8Zm-3-8.5h6v-1H9v1Zm0 2h6v-1H9v1Z"/>
        </svg>
      )}
    </a>
  </div>

  <p class="license-text">
    This work
    {title && <>, <em>{title}</em>,</>}
    {" "}by{" "}
    {authorUrl ? (
      <a href={authorUrl} rel="author">{authorDisplay}</a>
    ) : (
      <span>{authorDisplay}</span>
    )}
    {" "}is licensed under{" "}
    <a href={licenseUrl} target="_blank" rel="noopener noreferrer license">{licenseName}</a>.
  </p>
</div>}

<style>
  .license-info {
    border-top: 1px solid var(--color-lightgray);
    padding-top: 1rem;
    margin-top: 2rem;
  }

  .license-icons {
    display: flex;
    margin-bottom: 0.5rem;
  }

  .license-icons a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-darkgray);
    text-decoration: none;
  }

  .license-icons a:hover {
    color: var(--color-tertiary);
  }

  .cc-icon {
    flex-shrink: 0;
  }

  .license-text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-darkgray);
    margin: 0;
  }

  .license-text a {
    color: var(--color-secondary);
  }

  .license-text a:hover {
    color: var(--color-tertiary);
  }

  :global(.dark) .license-info {
    border-color: var(--color-gray);
  }
</style>
