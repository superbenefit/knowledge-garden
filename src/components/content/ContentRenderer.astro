---
import { renderMarkdown } from "../../lib/markdown";

interface Props {
  content: string;
}

const { content } = Astro.props;

const html = content ? await renderMarkdown(content) : "";
---

{html && (
  <article class="content-body" set:html={html} />
)}

<style>
  .content-body {
    font-family: var(--font-body);
    color: var(--color-dark);
    line-height: 1.75;
    max-width: none;
  }

  .content-body :global(h1),
  .content-body :global(h2),
  .content-body :global(h3),
  .content-body :global(h4),
  .content-body :global(h5),
  .content-body :global(h6) {
    font-family: var(--font-header);
    font-weight: 700;
    margin-bottom: 0.5em;
  }

  .content-body :global(h1) {
    font-size: 1.75rem;
    margin-top: 2em;
  }

  .content-body :global(h2) {
    font-size: 1.4rem;
    margin-top: 2.25em;
    padding-bottom: 0.3em;
    border-bottom: 1px solid var(--color-lightgray);
  }

  .content-body :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.75em;
  }

  .content-body :global(h4),
  .content-body :global(h5),
  .content-body :global(h6) {
    margin-top: 1.5em;
  }

  /* First heading in content should not have extra top margin */
  .content-body :global(:first-child) {
    margin-top: 0;
  }

  .content-body :global(p) {
    margin: 1em 0;
  }

  .content-body :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .content-body :global(a:hover) {
    color: var(--color-tertiary);
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    padding-left: 1.5em;
    margin: 1em 0;
  }

  .content-body :global(li) {
    margin: 0.35em 0;
  }

  .content-body :global(li > ul),
  .content-body :global(li > ol) {
    margin: 0.25em 0;
  }

  /* Blockquotes */
  .content-body :global(blockquote) {
    border-left: 3px solid var(--color-secondary);
    padding: 0.5em 1em;
    margin: 1.25em 0;
    background-color: var(--color-highlight);
    border-radius: 0 0.25rem 0.25rem 0;
    color: var(--color-darkgray);
    font-style: italic;
  }

  .content-body :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .content-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Inline code */
  .content-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-lightgray);
    padding: 0.15em 0.4em;
    border-radius: 0.25em;
    border: 1px solid transparent;
  }

  /* Code blocks */
  .content-body :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    background-color: var(--color-lightgray);
    padding: 1.25em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin: 1.5em 0;
    line-height: 1.55;
    border: 1px solid transparent;
  }

  .content-body :global(pre code) {
    background: none;
    padding: 0;
    border: none;
    font-size: inherit;
  }

  /* Tables */
  .content-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.925rem;
  }

  .content-body :global(th),
  .content-body :global(td) {
    border: 1px solid var(--color-lightgray);
    padding: 0.6em 0.85em;
    text-align: left;
  }

  .content-body :global(th) {
    font-weight: 600;
    background-color: var(--color-lightgray);
  }

  .content-body :global(tr:nth-child(even)) {
    background-color: var(--color-highlight);
  }

  .content-body :global(tr:hover) {
    background-color: var(--color-highlight);
  }

  /* Images */
  .content-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.375rem;
    display: block;
    margin: 1.5em auto;
  }

  /* Horizontal rules */
  .content-body :global(hr) {
    border: none;
    border-top: 1px dashed var(--color-gray);
    margin: 2.5em 0;
    opacity: 0.5;
  }
</style>
