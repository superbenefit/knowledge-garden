---
import "@/styles/global.css";
import SEOHead from "@/components/content/SEOHead.astro";

interface Props {
  title: string;
  description?: string | undefined;
}

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        var s = localStorage.getItem("theme");
        if (s === "dark" || (!s && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <title>{title}</title>
    <SEOHead title={title} {...(description != null && { description })} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page-grid">
      <div class="grid-area-sidebar-left">
        <slot name="sidebar-left" />
      </div>
      <div class="grid-area-header">
        <slot name="header" />
      </div>
      <div class="grid-area-center">
        <slot />
      </div>
      <div class="grid-area-sidebar-right">
        <slot name="sidebar-right" />
      </div>
      <div class="grid-area-footer">
        <slot name="footer" />
      </div>
    </div>
  </body>
</html>
