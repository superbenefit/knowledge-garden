---
import BaseLayout from "./BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Sidebar from "./Sidebar.astro";
import SidebarNav from "./SidebarNav.astro";

interface Props {
  title: string;
  description?: string | undefined;
  showLeftSidebar?: boolean | undefined;
  showRightSidebar?: boolean | undefined;
  mobileDrawer?: boolean | undefined;
  currentPath?: string | undefined;
}

const {
  title,
  description,
  showLeftSidebar = true,
  showRightSidebar = true,
  mobileDrawer = false,
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  {showLeftSidebar && (
    <Sidebar side="left" slot="sidebar-left" mobileDrawer={mobileDrawer}>
      <SidebarNav currentPath={currentPath} />
      <slot name="sidebar-left" />
    </Sidebar>
  )}

  <main class="content-area">
    <slot name="before-content" />
    <slot />
    <slot name="after-content" />
  </main>

  {showRightSidebar && (
    <Sidebar side="right" slot="sidebar-right">
      <slot name="sidebar-right" />
    </Sidebar>
  )}

  <Footer slot="footer" />
</BaseLayout>
