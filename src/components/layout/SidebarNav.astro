---
import DocsTree from "@/components/layout/DocsTree.astro";

interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const isLinksActive = currentPath.startsWith("/link");
const isLexiconActive = currentPath.startsWith("/tag");

// Derive current slug for docs tree highlighting
const docsSlug = currentPath.startsWith("/docs")
  ? currentPath.replace(/^\/docs\/?/, "").replace(/\/$/, "")
  : "";
---

<nav class="sidebar-nav" aria-label="Site navigation">
  <!-- Top links -->
  <div class="sidebar-nav-top-links">
    <a href="/tag" class:list={["sidebar-nav-top-link", isLexiconActive && "active"]}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      Lexicon
    </a>
    <a href="/link" class:list={["sidebar-nav-top-link", isLinksActive && "active"]}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      Links
    </a>
  </div>

  <!-- Spacer -->
  <hr class="sidebar-nav-divider" />

  <!-- Docs tree — always open, SSR rendered -->
  <div class="sidebar-nav-docs">
    <div class="sidebar-nav-docs-header">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <a href="/docs" class="sidebar-nav-docs-title">Docs</a>
    </div>
    <div class="sidebar-nav-docs-tree">
      <DocsTree currentSlug={docsSlug} />
    </div>
  </div>
</nav>

<style>
  .sidebar-nav-top-links {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.25rem 0;
  }

  .sidebar-nav-top-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-dark);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sidebar-nav-top-link:hover {
    background-color: var(--color-highlight);
  }

  .sidebar-nav-top-link.active {
    color: var(--color-secondary);
    background-color: var(--color-highlight);
    font-weight: 600;
  }

  .sidebar-nav-divider {
    border: none;
    border-top: 1px solid var(--color-highlight);
    margin: 0.5rem 0.75rem;
  }

  .sidebar-nav-docs {
    padding: 0.25rem 0;
  }

  .sidebar-nav-docs-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    color: var(--color-dark);
  }

  .sidebar-nav-docs-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-dark);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sidebar-nav-docs-title:hover {
    color: var(--color-secondary);
  }

  .sidebar-nav-docs-tree {
    padding-left: 0.25rem;
  }
</style>
