---
export const prerender = false;

import ContentLayout from "@/components/layout/ContentLayout.astro";
import { getLiveCollection } from "astro:content";
import { fromCollectionEntry } from "@/lib/types";

let allDocs: ReturnType<typeof fromCollectionEntry>[] = [];
try {
  const result = await getLiveCollection("knowledge");
  allDocs = (result.entries ?? []).map((e) => fromCollectionEntry(e.id, e.data));
} catch {}

// Collect unique tags with counts from frontmatter tags
const tagCounts = new Map<string, number>();
for (const doc of allDocs) {
  if (doc.tags) {
    for (const tag of doc.tags) {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    }
  }
}

// Sort alphabetically
const sortedTags = [...tagCounts.entries()].sort((a, b) =>
  a[0].localeCompare(b[0])
);
---

<ContentLayout title="Tags | SuperBenefit Knowledge Garden" description="Browse content by tag.">
  <nav class="text-sm mb-6" style="color: var(--color-gray)">
    <a href="/" class="hover:underline">Home</a>
    <span class="mx-1">/</span>
    <span style="color: var(--color-dark)">Tags</span>
  </nav>

  <h1 class="text-3xl font-bold mb-2" style="font-family: var(--font-header)">
    Tags
  </h1>
  <p class="text-lg mb-8" style="color: var(--color-darkgray)">
    {sortedTags.length} tags across all content.
  </p>

  {sortedTags.length > 0 ? (
    <div class="tag-cloud">
      {sortedTags.map(([tag, count]) => (
        <a href={`/tags/${tag}`} class="tag-cloud-item">
          <span class="tag-name">{tag}</span>
          <span class="tag-count">{count}</span>
        </a>
      ))}
    </div>
  ) : (
    <p style="color: var(--color-gray)">No tags found.</p>
  )}
</ContentLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-cloud-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-lightgray);
    border-radius: 9999px;
    font-size: 0.875rem;
    color: var(--color-secondary);
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s;
  }

  .tag-cloud-item:hover {
    background-color: var(--color-highlight);
    border-color: var(--color-secondary);
    color: var(--color-tertiary);
  }

  .tag-count {
    font-size: 0.75rem;
    padding: 0 0.375rem;
    border-radius: 9999px;
    background-color: var(--color-highlight);
    color: var(--color-darkgray);
    min-width: 1.25rem;
    text-align: center;
  }

  :global(.dark) .tag-cloud-item {
    border-color: var(--color-gray);
  }

  :global(.dark) .tag-cloud-item:hover {
    border-color: var(--color-tertiary);
  }
</style>
