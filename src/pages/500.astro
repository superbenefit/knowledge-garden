---
import ContentLayout from "@/components/layout/ContentLayout.astro";
---

<ContentLayout title="Something Went Wrong" showLeftSidebar={false} showRightSidebar={false}>
  <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 50vh; text-align: center; padding: 2rem;">
    <h1 style="font-family: var(--font-header); font-size: 4rem; font-weight: 700; color: var(--color-gray); margin: 0 0 0.5rem 0;">
      500
    </h1>
    <h2 style="font-family: var(--font-header); font-size: 1.5rem; font-weight: 600; color: var(--color-dark); margin: 0 0 1rem 0;">
      Something went wrong
    </h2>
    <p style="color: var(--color-darkgray); font-size: 1rem; max-width: 28rem; line-height: 1.6; margin: 0 0 2rem 0;">
      An unexpected error occurred. Try refreshing the page or head back to the home page.
    </p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
      <a
        href="/"
        style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 0.375rem; background-color: var(--color-secondary); color: var(--color-light); font-family: var(--font-header); font-weight: 600; font-size: 0.9rem; text-decoration: none;"
      >
        Go home
      </a>
      <button
        onclick="window.location.reload()"
        style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; border-radius: 0.375rem; border: 1px solid var(--color-lightgray); background: none; color: var(--color-dark); font-family: var(--font-header); font-weight: 600; font-size: 0.9rem; cursor: pointer;"
      >
        Refresh page
      </button>
    </div>
  </div>
</ContentLayout>
