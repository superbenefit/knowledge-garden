---

import ContentLayout from "@/components/layout/ContentLayout.astro";
import Breadcrumbs from "@/components/content/Breadcrumbs.astro";
import BannerImage from "@/components/content/BannerImage.astro";
import TypeBadge from "@/components/content/TypeBadge.astro";
import TagList from "@/components/content/TagList.astro";
import ContentMeta from "@/components/content/ContentMeta.astro";
import TableOfContents from "@/components/content/TableOfContents.astro";
import { getLiveEntry } from "astro:content";
import { isContentType, TYPE_LABELS, fromCollectionEntry } from "@/lib/types";
import { renderMarkdown, extractHeadings } from "@/lib/markdown";

const { type, id } = Astro.params;

if (!type || !id || !isContentType(type)) {
  Astro.response.status = 404;
}

let entry: ReturnType<typeof fromCollectionEntry> | null = null;
if (type && id && isContentType(type)) {
  try {
    const result = await getLiveEntry("knowledge", `content/${type}/${id}.json`);
    if (result.entry) {
      entry = fromCollectionEntry(result.entry.id, result.entry.data);
    }
  } catch {}
}

if (!entry) {
  Astro.response.status = 404;
}

const html = entry ? await renderMarkdown(entry.body) : "";
const headings = html ? extractHeadings(html) : [];
const typeLabel = type ? TYPE_LABELS[type as keyof typeof TYPE_LABELS] || type : "";
const pageTitle = entry
  ? `${entry.title} | ${typeLabel} | SuperBenefit`
  : "Not Found | SuperBenefit";
---

<ContentLayout title={pageTitle} description={entry?.description} mobileDrawer={true}>
  {headings.length > 0 && (
    <TableOfContents headings={headings} slot="sidebar-right" />
  )}

  {!entry ? (
    <div>
      <h1>Not Found</h1>
      <p>The {typeLabel.toLowerCase() || "content"} you're looking for doesn't exist.</p>
      <a href={`/${type}`} style="color: var(--color-secondary); text-decoration: underline;">
        Back to {typeLabel || "listing"}
      </a>
    </div>
  ) : (
    <div>
      <Breadcrumbs url={Astro.url.pathname} />

      {entry.banner && (
        <BannerImage banner={entry.banner} title={entry.title} />
      )}

      <article style="margin-top: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.25rem;">
          <h1 style="margin: 0;">{entry.title}</h1>
          <TypeBadge type={entry.type} category={entry.category} />
        </div>

        <ContentMeta document={entry} />

        {entry.description && (
          <p style="font-size: 1.125rem; color: var(--color-darkgray); margin: 0 0 1.5rem 0;">
            {entry.description}
          </p>
        )}

        {entry.tags.length > 0 && (
          <div style="margin-bottom: 1.5rem;">
            <TagList tags={entry.tags} />
          </div>
        )}

        <article class="content-body" set:html={html} />
      </article>
    </div>
  )}
</ContentLayout>
