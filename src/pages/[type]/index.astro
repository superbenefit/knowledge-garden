---

import ContentLayout from "@/components/layout/ContentLayout.astro";
import Breadcrumbs from "@/components/content/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { isContentType, TYPE_LABELS, fromCollectionEntry } from "@/lib/types";

export async function getStaticPaths() {
  const entries = await getCollection("knowledge");
  const types = new Set<string>();
  for (const e of entries) {
    types.add(e.data.contentType as string);
  }
  return Array.from(types).map((type) => ({ params: { type } }));
}

const { type } = Astro.params;

if (!type || !isContentType(type)) {
  return Astro.redirect("/404");
}

const entries = await getCollection("knowledge");
const docs = entries
  .filter((e) => e.data.contentType === type)
  .map((e) => fromCollectionEntry(e.id, e.data));

const typeLabel = type ? TYPE_LABELS[type as keyof typeof TYPE_LABELS] || type : "";
const pluralLabel = typeLabel + "s";

const isTag = type === "tag";
const isLink = type === "link";
---

<ContentLayout
  title={`${pluralLabel} | SuperBenefit Knowledge Garden`}
  description={`Browse ${pluralLabel.toLowerCase()} in the SuperBenefit ecosystem.`}
  mobileDrawer={true}
  showRightSidebar={false}
>
  <Breadcrumbs url={Astro.url.pathname} />

  <h1 class="type-index-title">{isTag ? "Lexicon" : isLink ? "Links" : pluralLabel}</h1>
  <p class="type-index-subtitle">
    {isTag
      ? "Concepts and definitions in the SuperBenefit knowledge base."
      : isLink
        ? "Curated resources and references from across the web."
        : `${docs.length} ${docs.length === 1 ? typeLabel.toLowerCase() : pluralLabel.toLowerCase()} in the knowledge garden.`}
  </p>

  {docs.length > 0 ? (
    isTag ? (
      <div class="concept-grid">
        {docs.map((entry) => (
          <a href={`/${entry.type}/${entry.id}`} class="concept-card">
            <span class="concept-card-title">{entry.title}</span>
            {entry.description && (
              <span class="concept-card-desc">{entry.description}</span>
            )}
            {entry.category && (
              <span class="concept-card-badge">{entry.category}</span>
            )}
          </a>
        ))}
      </div>
    ) : isLink ? (
      <div class="link-grid">
        {docs.map((entry) => (
          <a href={`/${entry.type}/${entry.id}`} class="link-card">
            <div class="link-card-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </div>
            <div class="link-card-body">
              <span class="link-card-title">{entry.title}</span>
              {entry.description && (
                <span class="link-card-desc">{entry.description}</span>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div>
        {docs.map((entry) => (
          <div class="doc-list-item">
            <a href={`/${entry.type}/${entry.id}`} class="doc-list-item-title">
              {entry.title}
            </a>
            {entry.description && (
              <p class="doc-list-item-desc">{entry.description}</p>
            )}
            {entry.tags.length > 0 && (
              <div class="doc-list-item-tags">
                {entry.tags.map((tag) => (
                  <span class="doc-list-item-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    )
  ) : (
    <p style="color: var(--color-gray)">No {pluralLabel.toLowerCase()} found.</p>
  )}
</ContentLayout>

<style>
  .type-index-title {
    margin: 1rem 0 0.25rem 0;
  }

  .type-index-subtitle {
    color: var(--color-darkgray);
    margin: 0 0 2rem 0;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }

  .concept-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-lightgray);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .concept-card:hover {
    border-color: var(--color-secondary);
    background-color: var(--color-highlight);
  }

  .concept-card-title {
    font-family: var(--font-header);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-secondary);
  }

  .concept-card-desc {
    font-size: 0.8rem;
    color: var(--color-darkgray);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .concept-card-badge {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-highlight);
    color: var(--color-secondary);
    font-family: var(--font-header);
  }

  .link-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-lightgray);
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .link-card:hover {
    border-color: var(--color-secondary);
    background-color: var(--color-highlight);
  }

  .link-card-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: var(--color-gray);
  }

  .link-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .link-card-title {
    font-family: var(--font-header);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .link-card-desc {
    font-size: 0.8rem;
    color: var(--color-darkgray);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .doc-list-item-tag {
    font-size: 0.7rem;
    padding: 0.1rem 0.5rem;
    border-radius: 9999px;
    background: var(--color-highlight);
    color: var(--color-secondary);
  }
</style>
